{
    "name": "age/age-archive",
    "description": "Enterprise Mail Archive",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0",
        "ezyang/htmlpurifier": "^4.19",
        "sabre/dav": "^4.7",
        "sabre/vobject": "^4.5",
        "symfony/mime": "^7.4",
        "webklex/php-imap": "^6.2",
        "egulias/email-validator": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2"
    }
}
