{
    "name": "age/age-archive",
    "description": "Enterprise Mail Archive",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "classes/App/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}