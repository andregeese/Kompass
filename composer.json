{
    "name": "age/age-archive",
    "description": "Enterprise Mail Archive",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0",
        "ezyang/htmlpurifier": "^4.19",
        "sabre/dav": "^4.7",
        "sabre/vobject": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "classes/App/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
