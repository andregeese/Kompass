            [sql] => SELECT 
                    HEX(AES_ENCRYPT(CAST(c.id as CHAR), '6bd8960a14d499c8a42c4354c27b65943822e9a94ee92c888eab3d495450f85b')) as contact_id,
                    c.display_name,
                    c.type,
                    GROUP_CONCAT(ce.email SEPARATOR ', ') AS additional_emails
                FROM mails AS m
                -- 1. Verbindung zur E-Mail-Tabelle über die sender_ceid
                INNER JOIN contact_emails AS ce ON m.sender_ceid = ce.id
                -- 2. Verbindung zur Kontakt-Tabelle
                INNER JOIN contacts AS c ON ce.contact_id = c.id
                WHERE m.id = CAST(AES_DECRYPT(UNHEX('0B5F013E877CB6A912CA9D90F04C01C3'), '6bd8960a14d499c8a42c4354c27b65943822e9a94ee92c888eab3d495450f85b') AS UNSIGNED)
