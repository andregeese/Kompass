    [debug] => Array
        (
            [caller] => DB Query von: App\Services\MailProcessor->getMailsThatShouldBeAnswered
            [sql] =>  WITH contact_stats AS (
                    -- 1. Historische Antwortquote pro KONTAKT (über alle seine E-Mail-Adressen hinweg) berechnen
                    SELECT 
                        ce.contact_id,
                        COUNT(m.id) AS total_mails,
                        ROUND((SUM(m.is_answered) * 100.0) / COUNT(m.id), 2) AS response_rate_pct
                    FROM mails m
                    INNER JOIN contact_emails ce ON ce.id = m.sender_ceid
                    WHERE m.tenant_id = 1
                    AND m.status = 'active'
                    AND m.is_newsletter = 0
                    GROUP BY ce.contact_id
                )
                -- 2. Gruppierung rein auf Kontaktebene
                SELECT 
                    c.id AS contact_id,
                    COALESCE(NULLIF(c.display_name, ''), GROUP_CONCAT(DISTINCT ce.email SEPARATOR ', ')) AS contact_name,
                    GROUP_CONCAT(DISTINCT ce.email SEPARATOR ', ') AS associated_emails,
                    COUNT(m.id) AS unanswered_count,
                    MAX(m.date_received) AS latest_unanswered_date,
                    stats.response_rate_pct
                FROM mails m
                INNER JOIN contact_emails ce ON ce.id = m.sender_ceid
                LEFT JOIN contacts c ON c.id = ce.contact_id
                INNER JOIN contact_stats stats ON stats.contact_id = ce.contact_id
                WHERE m.tenant_id = 1
                AND m.status = 'active'
                AND m.is_answered = 0
                AND m.is_newsletter = 0
                -- Relevanz-Filter:
                AND stats.response_rate_pct >= 30.0
                AND stats.total_mails >= 2
                GROUP BY c.id, c.display_name, stats.response_rate_pct
                HAVING COUNT(m.id) <= 15
                ORDER BY latest_unanswered_date DESC, stats.response_rate_pct DESC;
        )

)

