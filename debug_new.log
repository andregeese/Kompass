                FROM mails m
                -- 1. Finde den Kontakt, der zu diesem spezifischen Hash gehört
                JOIN contact_emails ce_target ON ce_target.email_hash = '91d35e67c826c88b4bd74a8b153b672cb1c7fed286dca4780024da9c79e57c32'
                -- 2. Finde alle E-Mail-Adressen, die zu DIESEM Kontakt gehören
