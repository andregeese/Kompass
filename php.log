[31-May-2026 11:57:00 UTC] DB Query SELECT 
                    'mail' AS type,
                    m.id AS item_id,
                    ref.paperless_id as paperlesscontact,
                    -- ce.paperless_id as paperlesscorrespondent
                    m.paperless_id as paperlessdocument,
                    m.date_received AS event_date,
                    m.subject_hash AS title,
                    m.sender AS detail
                FROM mails AS m
                INNER JOIN (
                    SELECT sender_ceid, recipient_id, paperless_id FROM mails WHERE id_hash = UNHEX(:hash) LIMIT 1
                ) AS ref ON m.sender_ceid = ref.sender_ceid ON m.recipient_ceid = ref.recipient_ceid
                WHERE m.tenant_id = :tenant_id AND m.status NOT IN ('deleted')
                ORDER BY m.date_received DESC LIMIT 100;
