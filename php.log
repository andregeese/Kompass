                LEFT JOIN contacts as c ON c.id=ce.contact_id
                
                WHERE c.tenant_id = 6
                  AND ce.email_hash='ABC'
                -- Hier kannst du nach Bedarf filtern
                ORDER BY c.display_name, ce.email
)

