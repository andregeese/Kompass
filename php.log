                    JOIN contact_emails ce ON (m.sender_ceid = ce.id OR m.recipient_ceid = ce.id)
                    WHERE ce.contact_id IN (
                        -- Subquery: Finde den Kontakt, der zur Ausgangs-Mail gehÃ¶rt
                        SELECT contact_id 
                        FROM contact_emails 
                        WHERE id IN (
                            SELECT sender_ceid 
                            FROM mails 
                            WHERE id_hash = UNHEX('b8370c2ed3d540710a6ca46eb11510b3912cfb7fd6d376f2e4644528c57b004b')
                        )
                    )
                    AND m.tenant_id = 6 
                    AND m.status != 'deleted'
                    ORDER BY m.date_received DESC
                    LIMIT 1000;
