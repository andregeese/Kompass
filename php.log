[03-Jun-2026 11:57:34 UTC] getContactByMail
[03-Jun-2026 11:57:34 UTC] DB DEBUG: Array
(
    [caller] => DB Query von: App\Services\ContactProcessor->getContactByMail
    [sql] => SELECT 
                    c.id AS contact_id,
                    c.display_name,
                    c.type,
                    c.paperless_id,
                    GROUP_CONCAT(ce.email SEPARATOR ', ') AS additional_emails
                FROM mails AS m
                -- 1. Verbindung zur E-Mail-Tabelle über die sender_ceid
                INNER JOIN contact_emails AS ce ON m.sender_ceid = ce.id
                -- 2. Verbindung zur Kontakt-Tabelle
                INNER JOIN contacts AS c ON ce.contact_id = c.id
                WHERE m.id_hash = UNHEX('4dc2b1f120a2a949e1bdc1c6ec8da2097c7f132fa07e30c86fbbfcfb94653abc')
                AND m.tenant_id = 6
                GROUP BY c.id, c.display_name, c.type, c.paperless_id;
)

