    [caller] => DB Query von: App\Services\ContactProcessor->getContactByEmailHash
    [sql] => SELECT 
                    c.id AS contact_id,
                    c.is_active as is_active,
                    c.display_name as displayname,
                    c.type,
                    ce.id AS ceid,
                    ce.email
