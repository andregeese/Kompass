[31-May-2026 11:47:43 UTC] SQL: SELECT 
                    m.id, uid, sender, recipient, subject_hash, m.paperless_id, imap_folder,
                    date_received as date, id_hash as hash,
                    is_read, is_flagged, is_answered, c.display_name as displayname, cm.email_hash as emailhash
                FROM mails as m
                LEFT JOIN contact_emails as cm ON cm.id = m.sender_ceid
                LEFT JOIN contacts as c ON c.id = cm.contact_id
                WHERE m.tenant_id = :tenant_id
                AND imap_folder = :folder
                AND (status NOT IN('deleted') OR status IS NULL) ORDER BY date_received DESC LIMIT :limit OFFSET :offset
[31-May-2026 11:47:43 UTC] contact ID nach speichern 1:0
[31-May-2026 11:47:43 UTC] SELECT ID nach speichern 2:541
[31-May-2026 11:47:43 UTC] getMailsPaginated PARAMS: Array
(
    [folder] => INBOX
    [limit] => 50
    [offset] => 0
    [tenant_id] => 6
)

