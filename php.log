(
    [caller] => DB Query von: App\Services\ContactProcessor->getMailItems
    [sql] => SELECT 'mail' AS type,
                    m.id AS item_id,
                    m.paperless_id AS paperlessdocument,
                    m.date_received AS event_date,
                    m.subject_hash AS title,
                    m.sender AS detail
                    FROM mails m
                    -- Join, um alle ceids zu finden, die zum Kontakt der Ausgangs-Mail gehÃ¶ren
                    JOIN contact_emails ce ON (m.sender_ceid = ce.id OR m.recipient_ceid = ce.id)
                    WHERE ce.contact_id IN (
                        -- Subquery: Finde den Kontakt, der zur Ausgangs-Mail gehÃ¶rt
                        SELECT contact_id 
                        FROM contact_emails 
                        WHERE id IN (
                            SELECT sender_ceid 
                            FROM mails 
                            WHERE id_hash = UNHEX('77a8f8f2d347bd781510c0dfb32337dd7fb5f020eac38e2878f7b8590def35a2')
                        )
                    )
                    AND m.tenant_id = 6 
                    AND m.status != 'deleted'
                    ORDER BY m.date_received DESC
                    LIMIT 1000;
)

